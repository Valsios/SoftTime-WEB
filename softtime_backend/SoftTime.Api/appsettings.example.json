{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "None"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SoftTime": "Data Source=ServerAddress;Initial Catalog=DatabaseName;User ID=username;Password=password;TrustServerCertificate=True;Connect Timeout=60"
  },
  "Jwt": {
    "Issuer": "SoftTime",
    "Audience": "SoftTime.Web",
    "Key": "",
    "AccessTokenMinutes": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Security": {
    "RefreshTokenDays": 7,
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "AuthRequestsPerMinute": 20
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "User": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "SoftTime"
  },
  "Landing": {
    "DriftWeeks": 4,
    "HorizonWeeks": 4
  },
  "Database": {
    "AutoMigrate": true,
    "AutoMigrateLockTimeoutSeconds": 60
  },
  "SelfService": {
    "Enabled": "false"
  }
}
